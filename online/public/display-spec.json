{
  "referenceImage": "/assets/reference-mockup.png",
  "architecture": "The exemplar PNG is the full page. Live HTML overlays only appear when game state differs from the idle mockup.",
  "viewport": "reference-mockup.png scaled with object-fit:cover",
  "elements": [
    { "id": "baseArt", "selector": "#baseArt", "asset": "/assets/reference-mockup.png", "status": "match" },
    { "id": "liveLayer", "selector": "#liveLayer", "status": "match", "note": "Hidden (.is-idle) when API state matches idle mockup exactly" },
    { "id": "timerOverlay", "selector": "#timerOverlay", "status": "match" },
    { "id": "badgeOverlay", "selector": "#badgeOverlay", "status": "match" },
    { "id": "wordLayer", "selector": "#wordLayer", "status": "match" },
    { "id": "statsOverlays", "selector": ".ov-stat", "status": "match" },
    { "id": "playersLayer", "selector": "#playersLayer", "status": "match" }
  ]
}
